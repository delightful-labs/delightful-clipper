# Public production service coordinates, provided at build time.
PUBLIC_JAZZ_APP_ID=
PUBLIC_JAZZ_SERVER_URL=

# Netlify production build-only secret; configure in Netlify, never commit a value.
JAZZ_ADMIN_SECRET=
# Server-only canonical Jazz account registry URL (required for capture authentication).
# Preview tooling supplies the generated app registry at build time.
JAZZ_ACCOUNT_REGISTRY=
# Public build-time feature flag; gateway authentication remains mandatory.
# Production enablement is separate from runtime/network qualification.
CAPTURE_GATEWAY_ENABLED=false

# Finance-compatible opt-in: populate an authoritatively empty private library.
PUBLIC_FAKE_DATA=false

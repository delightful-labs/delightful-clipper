# Public same-origin backend coordinates (Vercel supplies these defaults).
PUBLIC_JAZZ_APP_ID=9c0871ad-3ea3-49d0-9eaf-b034914da924
PUBLIC_JAZZ_SERVER_URL=same-origin

# Public build-time feature flag; native capture authentication remains mandatory.
CAPTURE_GATEWAY_ENABLED=true

# Opt-in sample data for an authoritatively empty private library.
PUBLIC_FAKE_DATA=false

# Legacy Netlify investigation tooling only; not required by createJazz on Vercel.
# Never commit a real admin secret.
JAZZ_ADMIN_SECRET=
JAZZ_ACCOUNT_REGISTRY=

# Server-only Better Auth settings. Auth records live in the existing Jazz store.
# Use the stable origin of this environment; never commit a real secret.
AUTH_BASE_URL=
AUTH_SECRET=

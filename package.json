		"@xstate/immer": "^0.3.1",
		"@xstate/svelte": "^2.0.0",
		"events": "^3.3.0",
		"immer": "^9.0.16",
		"jsonata": "^1.8.6",
		"linkedom": "^0.14.21",
		"open-graph-scraper": "^5.0.1",
		"prettier": "^2.6.2",
		"prettier-plugin-svelte": "^2.7.0",
		"sanitize-html": "^2.7.3",
		"svelte": "^3.44.0",
		"svelte-check": "^2.7.1",
		"typescript": "^4.7.4",

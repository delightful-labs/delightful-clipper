{
	"name": "delightful-clipper",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": ">=24.22.2 <25",
		"pnpm": "10.22.0"
	},
	"scripts": {
		"preinstall": "node tooling/verify-vendor.mjs",
		"dev": "pnpm --filter @delightful-clipper/web dev",
		"build": "pnpm --filter @delightful-clipper/web build",
		"preview": "pnpm --filter @delightful-clipper/web preview",
		"check": "tsc --project tsconfig.json && pnpm --filter @delightful-clipper/web check && pnpm --filter @delightful-clipper/extension check",
		"lint": "oxlint --deny-warnings .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"verify:vendor": "node tooling/verify-vendor.mjs --installed",
		"verify": "pnpm verify:vendor && pnpm format:check && pnpm lint && pnpm check && pnpm test:unit && pnpm build",
		"test:unit": "pnpm --filter @delightful-clipper/web build:parser-worker:dev && vitest run",
		"test:e2e": "node tooling/test-browser.mjs",
		"test:schema": "playwright test --config playwright.schema.config.ts",
		"dev:agent": "pnpm --filter @delightful-clipper/web dev:agent",
		"test:offline": "node --experimental-strip-types apps/web/tests/offline-build.ts && playwright test --config playwright.offline.config.ts",
		"build:extension": "pnpm --filter @delightful-clipper/extension build",
		"test:extension": "node --experimental-strip-types apps/extension/tooling/test-build.ts && playwright test --config playwright.extension.config.ts",
		"test:worker": "playwright test --config playwright.worker.config.ts",
		"test:fake-data": "playwright test --config playwright.fake-data.config.ts"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"typescript": "6.0.3",
		"vitest": "4.1.8",
		"@playwright/test": "1.64.0",
		"@xstate/test": "2.0.0-beta.0",
		"fast-check": "4.10.2",
		"xstate": "6.0.0-beta.1"
	}
}
